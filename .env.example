# Vonage Demo-World - environment configuration
# Copy to .env (or set these on the host). Nothing account-specific lives in the source tree.

# ---- Vonage account and applications ----
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APP_ID=                      # messaging + voice application (RCS agent, WhatsApp number, SMS, Viber, Voice webhooks)
VONAGE_PRIVATE_KEY_FILE=private.key # RS256 private key of VONAGE_APP_ID (or set VONAGE_PRIVATE_KEY with the PEM)
VIDEO_APP_ID=                       # Vonage Video application
VIDEO_PRIVATE_KEY_FILE=video.key
DWVOICE_APP_ID=                     # Client SDK (browser calling) application
DWVOICE_PRIVATE_KEY_FILE=dwvoice.key

# ---- Senders ----
WA_NUMBER=                          # WhatsApp Business number, digits only
WA_WABA_ID=                         # WhatsApp Business Account id (template management)
RCS_SENDER=                         # launched RCS agent id
RBM_AGENT=                          # RBM deep-link handle for QR codes (e.g. <agent>_<id>_agent)
VIBER_FROM=                         # Viber Business service id
SMS_FROM=                           # numeric SMS sender (defaults to WA_NUMBER)
VOICE_NUMBER=                       # outbound caller id (defaults to WA_NUMBER)
DW_WEB_LVN=                         # number that rings the browser dialer demo

# ---- Where the app is reachable (HTTPS front, used for webhooks, webviews and QR codes) ----
PUBLIC_BASE=https://your-domain.example
PORT=8081

# ---- Storage and AI ----
S3_BUCKET=
S3_REGION=eu-north-1
DATA_PREFIX=demoworld/data/         # private JSON state
ASSET_BASE=https://<bucket>.s3.<region>.amazonaws.com/demoworld   # public assets (images, videos, shop pages)
BEDROCK_REGION=us-east-1
BEDROCK_MODELS=us.anthropic.claude-sonnet-4-20250514-v1:0
GEMINI_API_KEY=                     # vision + image generation for the branded demos

# ---- Demo-World accounts and mail ----
DW_ADMIN_EMAIL=                     # the owner account (admin console)
DW_ALLOWED_DOMAIN=vonage.com        # registration limited to this email domain
DW_AUTH_SECRET=                     # session signing secret (random string)
DW_ADMIN_KEY=                       # key for owner-only JSON endpoints
DW_SEED_PASSWORD=                   # optional: seeds DW_ADMIN_EMAIL as a verified owner on first boot
GMAIL_USER=                         # SMTP sender for verification / reset mail
GMAIL_APP_PASS=                     # Google app password
# Gmail API (OAuth) fallback sender, optional:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Satellite services (see ./vcr) and optional CRM forwards; blank = disabled ----
AVON_SKIN_URL=                      # vcr/avon-skin instance URL
OPTOUT_URL=                         # vcr/optout-manager instance URL
HUBSPOT_INBOUND_URL=
SALESHUB_INBOUND_URL=
HUBSPOT_GUIDE_URL=
HUB_URL=
PEAK_DATE=2026-10-15
PEAK_DIAL_NUMBER=                   # the number the "Call us" chip dials in the event demo

RCS_TEST_AGENT_ID=                  # Channel Manager id of the RCS test agent (tester management)
